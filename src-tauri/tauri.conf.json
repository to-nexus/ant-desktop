{
  "$schema": "https://raw.githubusercontent.com/nicegist/nicegist-tools/main/schema.json",
  "productName": "ant-companion",
  "version": "0.1.0",
  "identifier": "com.ant.companion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ant-companion",
        "label": "main",
        "width": 480,
        "height": 600,
        "resizable": false,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ant-companion"]
      }
    }
  }
}
