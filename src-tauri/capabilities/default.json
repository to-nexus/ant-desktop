{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for ant-desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",
    "deep-link:default",
    "store:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "figma://*" }
      ]
    }
  ]
}
